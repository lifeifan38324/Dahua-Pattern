{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\*.c",
                "-o",
                "$${workspaceFolder}\\myProgram.exe"
            ],
            "options": {
                "cwd": "C:/MinGW/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "编译器: C:/MinGW/bin/gcc.exe"
        },
        {
            "type": "cppbuild",  // 任务类型，通常为 shell 或 process
            "label": "C/C++: g++.exe 生成活动文件",  // 任务的名称，显示在 VSCode 的任务面板中
            "command": "g++.exe",  // 使用的编译器
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\src\\*.cpp",
                "${workspaceFolder}\\src\\func\\*\\*.cpp",
                "-I","${workspaceFolder}\\src\\func",
                "-I","${workspaceFolder}\\inc",
                "-o",
                "${workspaceFolder}\\build\\main.exe"
                // "${workspaceFolder}\\build\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                {
                    "base": "$gcc",  // 使用gcc的问题匹配器
                    "fileLocation": [
                        "relative",
                        "${fileDirname}"
                    ]
                }
            ],
            "detail": "调试器生成的任务。"
        },
        {
            "label": "make",
            "type": "shell",
            "command": "powershell make -f makefile",
            // "args": [
            //     "make -f makefile"
            // ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
    ],
    
    "presentation": {//执行这个任务时的一些其他设定
        "echo": true,//表示在执行任务时在终端要有输出
        "reveal": "always",//执行任务时是否跳转到终端面板，可以为always，silent，never
        "focus": true,//设为true后可以使执行task时焦点聚集在终端，但对编译来说，设为true没有意义，因为运行的时候才涉及到输入
        "panel": "new", //每次执行这个task时都新建一个终端面板
        "showReuseMessage": true,//控制是否显示“终端将被任务重用, 按任意键关闭”提示.
        "clear": false
    }
}